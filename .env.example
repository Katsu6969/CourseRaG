# Optional Cloud LLM Configuration
# CourseRAG works out of the box in Local Extractive Mode without any API key.
# To enable generative answers via a cloud model, set ONE of the keys below
# (or paste it directly in the Streamlit sidebar at runtime).

LLM_PROVIDER=auto
# Options: auto | local | groq | gemini | openai

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
